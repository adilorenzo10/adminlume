#: src/class-settings.php:96
msgid "Access denied."
msgstr "Accesso non consentito."

#: src/class-settings.php:99
msgid "Only POST requests are allowed."
msgstr "Sono consentite solo richieste POST."

#: src/class-settings.php:120
msgid "A softer interface without changing how you work. These preferences apply only to your account."
msgstr "Un’interfaccia più morbida, senza cambiare il modo in cui lavori. Queste preferenze valgono solo per il tuo utente."

#: src/class-settings.php:123
msgid "Preferences saved."
msgstr "Preferenze salvate."

#: src/class-settings.php:129
msgid "Appearance"
msgstr "Aspetto"

#: src/class-settings.php:130
msgid "Enable Adminlume for me"
msgstr "Abilita Adminlume per me"

#: src/class-settings.php:131
msgid "You can return to the default WordPress appearance at any time."
msgstr "Puoi tornare all’aspetto WordPress standard in qualsiasi momento."

#: src/class-settings.php:133
msgid "Sidebar and top bar background"
msgstr "Sfondo sidebar e top bar"

#: src/class-settings.php:135
msgid "Default: black (#000000). Text and icons adapt to light or dark backgrounds. Button colors remain independent."
msgstr "Predefinito: nero (#000000). Testi e icone si adattano ai colori chiari o scuri. Il colore dei pulsanti rimane indipendente."

#: src/class-settings.php:137
msgid "Accent color"
msgstr "Colore principale"

#: src/class-settings.php:139
msgid "Button text contrast adjusts automatically."
msgstr "Il contrasto del testo sui pulsanti viene adattato automaticamente."

#: src/class-settings.php:141
msgid "Panel corner radius"
msgstr "Arrotondamento pannelli"

#: src/class-settings.php:145
msgctxt "panel corner radius"
msgid "Subtle"
msgstr "Discreto"

#: src/class-settings.php:146
msgctxt "panel corner radius"
msgid "Medium"
msgstr "Medio"

#: src/class-settings.php:147
msgctxt "panel corner radius"
msgid "Soft"
msgstr "Morbido"

#: src/class-settings.php:156
msgid "Save preferences"
msgstr "Salva preferenze"

#: src/class-settings.php:158
msgid "On your site, only your admin toolbar is restyled; visitors see no changes. No remote fonts, tracking, or frameworks. The block editor and third-party plugins keep their own controls."
msgstr "Sul sito, solo la tua barra amministrativa riceve lo stesso stile: nessuna modifica per i visitatori. Nessun font remoto, tracciamento o framework. Editor a blocchi e plugin esterni mantengono i propri controlli."
