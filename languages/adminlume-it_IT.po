msgstr "Accesso non consentito."

#: src/Settings.php:80
msgid "A softer interface without changing how you work. These preferences apply only to your account."
msgstr "Un’interfaccia più morbida, senza cambiare il modo in cui lavori. Queste preferenze valgono solo per il tuo utente."

#: src/Settings.php:82
msgid "Preferences saved."
msgstr "Preferenze salvate."

#: src/Settings.php:88
msgid "Appearance"
msgstr "Aspetto"

#: src/Settings.php:89
msgid "Enable Adminlume for me"
msgstr "Abilita Adminlume per me"

#: src/Settings.php:90
msgid "You can return to the default WordPress appearance at any time."
msgstr "Puoi tornare all’aspetto WordPress standard in qualsiasi momento."

#: src/Settings.php:92
msgid "Sidebar and top bar background"
msgstr "Sfondo sidebar e top bar"

#: src/Settings.php:94
msgid "Default: black (#000000). Text and icons adapt to light or dark backgrounds. Button colors remain independent."
msgstr "Predefinito: nero (#000000). Testi e icone si adattano ai colori chiari o scuri. Il colore dei pulsanti rimane indipendente."

#: src/Settings.php:96
msgid "Accent color"
msgstr "Colore principale"

#: src/Settings.php:98
msgid "Button text contrast adjusts automatically."
msgstr "Il contrasto del testo sui pulsanti viene adattato automaticamente."

#: src/Settings.php:100
msgid "Panel corner radius"
msgstr "Arrotondamento pannelli"

#: src/Settings.php:102
msgctxt "panel corner radius"
msgid "Subtle"
msgstr "Discreto"

#: src/Settings.php:102
msgctxt "panel corner radius"
msgid "Medium"
msgstr "Medio"

#: src/Settings.php:102
msgctxt "panel corner radius"
msgid "Soft"
msgstr "Morbido"

#: src/Settings.php:108
msgid "Save preferences"
msgstr "Salva preferenze"

#: src/Settings.php:110
msgid "On your site, only your admin toolbar is restyled; visitors see no changes. No remote fonts, tracking, or frameworks. The block editor and third-party plugins keep their own controls."
msgstr "Sul sito, solo la tua barra amministrativa riceve lo stesso stile: nessuna modifica per i visitatori. Nessun font remoto, tracciamento o framework. Editor a blocchi e plugin esterni mantengono i propri controlli."

#: src/Updater.php:79
msgid "Adminlume release information is temporarily unavailable. Please try again later."
msgstr "Le informazioni sulle versioni di Adminlume sono temporaneamente non disponibili. Riprova più tardi."

#: src/Updater.php:93
msgid "A lightweight WordPress admin interface and front-end dock with personal preferences. Updates are supplied by the official Adminlume GitHub repository."
msgstr "Un'interfaccia amministrativa WordPress leggera e un dock frontend con preferenze personali. Gli aggiornamenti sono forniti dal repository GitHub ufficiale di Adminlume."

#: src/Updater.php:115
msgid "The Adminlume update could not be verified. Check for updates again before retrying."
msgstr "Impossibile verificare l'aggiornamento di Adminlume. Controlla di nuovo gli aggiornamenti prima di riprovare."

#: src/Updater.php:118
msgid "This Adminlume release requires a newer version of WordPress or PHP. The update was not installed."
msgstr "Questa versione di Adminlume richiede una versione più recente di WordPress o PHP. L'aggiornamento non è stato installato."

#: src/Updater.php:126
msgid "The Adminlume update checksum does not match. The update was not installed."
msgstr "Il checksum dell'aggiornamento di Adminlume non corrisponde. L'aggiornamento non è stato installato."
